# Supabase's Postgres, via the asyncpg driver.
# Supabase dashboard > Connect > Session pooler.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase dashboard > Project Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=


MISTRAL_API_KEY=

# Session cookies are sent only over HTTPS. Browsers treat http://localhost as secure,
# so set this to false only if your browser drops the cookies in local development.
COOKIE_SECURE=true
