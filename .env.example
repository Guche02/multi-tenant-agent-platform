# Copy to .env and fill in. Never commit .env.

# Postgres, via the asyncpg driver. Supabase's own Postgres works: use the direct connection
# or the session pooler (port 5432). The transaction pooler (port 6543) breaks asyncpg's
# prepared statements.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_platform

# Supabase dashboard > Project Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...), or the legacy anon key.
SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_...), or the legacy service_role key. Server only.
SUPABASE_SECRET_KEY=

# Session cookies are sent only over HTTPS. Browsers treat http://localhost as secure,
# so set this to false only if your browser drops the cookies in local development.
COOKIE_SECURE=true
